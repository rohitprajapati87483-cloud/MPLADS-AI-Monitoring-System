# Server
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./mplads.db

# Email / SMTP. Keep secrets only on the backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional AI provider. Leave blank to use the built-in explainable AI fallback.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Default notification recipients (comma separated). Configure real official addresses here.
DEFAULT_AUTHORITY_EMAILS=
